# Public URL of the live site (no trailing slash).
# Optional on Vercel — the production *.vercel.app URL is detected automatically.
# Set this when you add a custom domain, e.g. https://thirumalairaja.in
NEXT_PUBLIC_SITE_URL=

# Google Maps link for the office (opened in a new tab).
# Leave empty to use the Salem, Tamil Nadu city search.
NEXT_PUBLIC_OFFICE_MAP_URL=

# Google Maps embed URL for the office (the src of the "Embed a map" iframe).
# Leave empty to show Salem, Tamil Nadu.
NEXT_PUBLIC_OFFICE_MAP_EMBED_URL=
